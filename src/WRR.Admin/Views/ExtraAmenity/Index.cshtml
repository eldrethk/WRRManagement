@model IEnumerable<WRRManagement.Core.Entities.ExtraAmenity>

<h2>Extra Amenities</h2>
<p>
    <a asp-action="Create">Create New</a>
</p>

@if (Enumerable.Count(Model) > 0)
{
    <table class="table">
        <tr>

            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.Label("Amenity Type")
            </th>
            <th class="text-center">               
                @Html.DisplayNameFor(model => model.ShortDescription)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AmenityRate)              
            </th>
            <th class="text-center">
                @Html.DisplayNameFor(model => model.ViewOnRackRate)
            </th>
            <th></th>
        </tr>
        @foreach (var item in Model)
        {
            <tr>

                <td>
                    @item.Name
                </td>
                <td>
                    @{
                        var badgeClass = item.PricingType switch
                        {
                            WRRManagement.Core.Enums.AmenityPricingType.Discount => "text-secondary",
                            WRRManagement.Core.Enums.AmenityPricingType.OneTimeFee => "text-danger",
                            WRRManagement.Core.Enums.AmenityPricingType.OneTimeFeePerson => "text-warning",
                            WRRManagement.Core.Enums.AmenityPricingType.PerDay => "text-info",
                            WRRManagement.Core.Enums.AmenityPricingType.PerDayPerPerson => "text-primary",
                            WRRManagement.Core.Enums.AmenityPricingType.PerNightStay => "text-success",
                            _ => "text-muted"
                        };
                    }
                    <span class="@badgeClass font-weight-bold">@item.PricingType</span>
                </td>
                <td style="max-width:250px;">
                    @item.ShortDescription
                </td>
                <td class="text-center">
                    @item.AmenityRate.ToString("C")
                </td>

                <td class="text-center">
                    @if (item.ViewOnRackRate == true)
                    {
                        <span class="badge badge-pill badge-success">On</span>
                    }
                    else
                    {
                        <span class="badge badge-pill badge-danger">Off</span>
                    }
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.AmenityID">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.AmenityID">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.AmenityID" asp-route-name="@item.Name" asp-route-hotelid="@item.HotelID" onclick="return confirm('Are you sure you want to delete?');">Delete</a>
                </td>
            </tr>
        }

    </table>
}
else
{
    <div class="alert alert-warning">No Results</div>
}